<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EquipmentBorrowing.Desktop.App"
             xmlns:local="using:EquipmentBorrowing.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.heading">
  <Setter Property="FontSize" Value="20" />
  <Setter Property="FontWeight" Value="Bold" />
  <Setter Property="Margin" Value="0,0,0,8" />
</Style>

<Style Selector="TextBlock.appTitle">
  <Setter Property="FontSize" Value="18" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="Padding" Value="16,12" />
  <Setter Property="Background" Value="#2D3142" />
  <Setter Property="Foreground" Value="White" />
</Style>

<Style Selector="TextBlock.status">
  <Setter Property="Foreground" Value="#2D6A4F" />
  <Setter Property="FontStyle" Value="Italic" />
  <Setter Property="Margin" Value="0,4,0,0" />
</Style>

<Style Selector="Border.card">
  <Setter Property="Padding" Value="10" />
  <Setter Property="Margin" Value="0,2" />
  <Setter Property="BorderBrush" Value="#E0E0E0" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="4" />
</Style>

<Style Selector="Button.primary">
  <Setter Property="Background" Value="#3A5A9F" />
  <Setter Property="Foreground" Value="White" />
  <Setter Property="Padding" Value="12,6" />
</Style>

<Style Selector="StackPanel.nav">
  <Setter Property="Margin" Value="12" />
</Style>

<Style Selector="Button.navButton">
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Left" />
  <Setter Property="Padding" Value="10,8" />
</Style>
    </Application.Styles>
</Application>