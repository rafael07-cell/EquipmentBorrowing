<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="600"
		MinWidth ="850" MinHeight="500">

  <Grid RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Classes="appTitle" Text="Campus Equipment Borrowing System" />

    <Grid Grid.Row="1" ColumnDefinitions="200,*">
      <StackPanel Grid.Column="0" Classes="nav" Spacing="4">
        <Button Classes="navButton" Content="Equipment" Command="{Binding ShowEquipmentCommand}" />
        <Button Classes="navButton" Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}" />
      </StackPanel>

      <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:EquipmentViewModel">
            <views:EquipmentView />
          </DataTemplate>
          <DataTemplate DataType="vm:BorrowingsViewModel">
            <views:BorrowingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</Window>