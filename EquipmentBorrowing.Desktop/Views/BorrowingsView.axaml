<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16" RowSpacing="8">

    <TextBlock Grid.Row="0" Classes="heading" Text="Active Borrowings" />

    <ListBox Grid.Row="1" ItemsSource="{Binding ActiveBorrowings}"
             SelectedItem="{Binding SelectedBorrowing}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Classes="card">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Id, StringFormat='Borrowing #{0}'}" Width="120" />
              <TextBlock Text="{Binding StudentId, StringFormat='Student #{0}'}" Width="100" />
              <TextBlock Text="{Binding EquipmentId, StringFormat='Equipment #{0}'}" Width="110" />
              <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due {0:d}'}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="2" Classes="primary" Content="Return Equipment"
            Command="{Binding ReturnCommand}" HorizontalAlignment="Right" />

    <TextBlock Grid.Row="3" Classes="status" Text="{Binding StatusMessage}" />
  </Grid>
</UserControl>